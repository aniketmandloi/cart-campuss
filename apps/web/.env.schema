# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=string(matches="^(https?://|/(?!/))")
NEXT_PUBLIC_SERVER_URL=

# Server-only catalogue connection. Empty until a database is configured.
# @required=false @sensitive=true @type=string
DATABASE_URL=

# Private preview may read labelled synthetic fixtures. Public mode is the default.
# Server-only. Not a client variable.
# @type=boolean
CATALOGUE_ALLOW_FIXTURES=false
