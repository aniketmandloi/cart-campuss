# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Server-only credential for trusted-operator publishing. Leave it unset until an operator is configured.
# Do not add this key to the web or native schemas, and do not print its value.
# @required=false @type=string(minLength=32)
OPERATOR_TOKEN=

# Private preview may read labelled synthetic fixtures. Public mode is the default.
# Server-only. Not a client variable.
# @type=boolean
CATALOGUE_ALLOW_FIXTURES=false
